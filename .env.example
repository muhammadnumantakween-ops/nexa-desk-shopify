# NexaDesk Hydrogen Storefront - Environment Variables Template
# Copy this file to .env and fill in your actual values from Shopify Admin

# ============================================
# Session Security (Production/Preview only)
# ============================================
SESSION_SECRET="your-production-session-secret-here"

# ============================================
# Storefront API Configuration
# ============================================
# Private token for server-side queries (starts with shpat_)
PRIVATE_STOREFRONT_API_TOKEN="shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Public token for client-side queries (hex string)
PUBLIC_STOREFRONT_API_TOKEN="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Store domain (myshopify.com domain)
PUBLIC_STORE_DOMAIN="your-store-name.myshopify.com"

# Store IDs (numeric)
PUBLIC_STOREFRONT_ID="your-storefront-id"
SHOP_ID="your-shop-id"

# ============================================
# Customer Account API Configuration
# ============================================
PUBLIC_CUSTOMER_ACCOUNT_API_CLIENT_ID="your-client-id-uuid"
PUBLIC_CUSTOMER_ACCOUNT_API_URL="https://shopify.com/your-shop-id"

# ============================================
# OAuth Endpoints
# ============================================
OAUTH_AUTHORIZE_ENDPOINT="https://shopify.com/authentication/your-shop-id/oauth/authorize"
OAUTH_TOKEN_ENDPOINT="https://shopify.com/authentication/your-shop-id/oauth/token"
OAUTH_LOGOUT_ENDPOINT="https://shopify.com/authentication/your-shop-id/logout"

# ============================================
# Analytics (Optional)
# ============================================
PUBLIC_GTM_ID="GTM-NEXADESK"

# ============================================
# HOW TO GET THESE VALUES:
# ============================================
#
# 1. Go to: Shopify Admin → Settings → Apps and integrations → Develop apps
#
# 2. Select your Hydrogen app (or create one)
#
# 3. Configuration tab:
#    - PRIVATE_STOREFRONT_API_TOKEN: Admin API → Copy the access token
#    - PUBLIC_STOREFRONT_API_TOKEN: Storefront API → Copy the public token
#    - PUBLIC_CUSTOMER_ACCOUNT_API_CLIENT_ID: In the config
#
# 4. General settings:
#    - PUBLIC_STORE_DOMAIN: Settings → General → Store address
#    - SHOP_ID: Settings → General (shown as Shop ID)
#
# 5. OAuth endpoints: Listed under "Application endpoints" in the app config
#
# 6. SESSION_SECRET: Generate a random SHA-256 hash (for production only)
#    $ node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
